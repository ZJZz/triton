  "cards": [
    {
      "dot": "emerald",
      "title": "Completion Contract",
      "items": [
        "Two async TMA launches can be in flight before the consumer blocks",
        "Each completed transfer records bytes onto the same mbarrier object",
        "The consumer waits once, at the shared join point, instead of per transfer"
      ]
    },
    {
      "dot": "rose",
      "title": "Separate Object, Separate Fence",
      "items": [
        "Descriptor metadata has its own acquire chain",
        "mbarrier initialization has its own visibility chain when shared across CTAs",
        "The shared tile becomes consumable only after the whole expected set is observed"
      ]
    },
    {
      "dot": "orange",
      "title": "What This Is Not",
      "items": [
        "wait_barrier is not a whole-CTA rendezvous",
        "mbarrier tracks async completion, not generic-proxy ordering",
        "This join point can aggregate several async tasks without changing the protocol family"
      ]
    }
  ]
