  "cards": [
    {
      "dot": "emerald",
      "title": "What wait_group Proves",
      "items": [
        "Three async copies can be in flight before the thread blocks",
        "wait_group joins those in-flight copies for the issuing thread",
        "CTA peers are still outside the protocol until the later barrier"
      ]
    },
    {
      "dot": "rose",
      "title": "Why the Barrier Remains",
      "items": [
        "The async fan-out retires into shared memory, not directly into CTA-wide legality",
        "A CTA barrier turns per-thread completion into block-wide visibility",
        "This is the classic sm80 join after per-thread async work"
      ]
    },
    {
      "dot": "orange",
      "title": "Mental Model",
      "items": [
        "cp.async completion is not the same thing as CTA rendezvous",
        "commit_group / wait_group answer which async tasks have finished",
        "ttg.barrier answers when the whole CTA may safely consume next"
      ]
    }
  ]
