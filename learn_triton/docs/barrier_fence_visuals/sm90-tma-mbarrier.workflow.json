{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "sm90 TMA + mbarrier Protocol Explained",
    "subtitle": "This view shows the HBM source, TensorMap descriptor, shared-memory destination, and the CTA or cluster scope guarded by wait_barrier.",
    "output": "learn_triton/docs/barrier_fence_visuals/sm90-tma-mbarrier.html",
    "viewBox": [720, 980],
    "animation": "trace"
  },
  "lanes": [
    { "id": "input", "label": "Input Memory" },
    { "id": "desc", "label": "Descriptor / Metadata" },
    { "id": "issuer", "label": "Launch Scope" },
    { "id": "engine", "label": "Async Module" },
    { "id": "output", "label": "Output Memory" },
    { "id": "sync", "label": "Completion Object + Wait" },
    { "id": "consumer", "label": "Legal Consumer" }
  ],
  "phases": [
    { "id": "source", "label": "Inputs", "fromCol": 0, "toCol": 1 },
    { "id": "launch", "label": "Launch", "fromCol": 2, "toCol": 2, "variant": "emphasis" },
    { "id": "land", "label": "Shared dst", "fromCol": 3, "toCol": 3 },
    { "id": "join", "label": "Who waits and at what scope", "fromCol": 4, "toCol": 5, "variant": "security" }
  ],
  "nodes": [
    { "id": "hbm", "lane": "input", "col": 0, "type": "external", "label": "HBM tile", "sublabel": ".global device memory", "tag": "input memory type" },
    { "id": "tmap", "lane": "desc", "col": 3, "type": "security", "label": "TensorMap", "sublabel": "descriptor metadata", "tag": "must be visible with acquire .gpu" },
    { "id": "leader", "lane": "issuer", "col": 1, "type": "frontend", "label": "CTA leader", "sublabel": "init_barrier + expect", "tag": "launch scope: CTA or cluster leader" },
    { "id": "tma", "lane": "engine", "col": 2, "type": "cloud", "label": "TMA engine", "sublabel": "async_tma s0/s1", "tag": "module: cp.async.bulk.tensor" },
    { "id": "smem", "lane": "output", "col": 3, "type": "database", "label": "stage buffer", "sublabel": ".shared::cta / ::cluster", "tag": "output memory type" },
    { "id": "mbar", "lane": "sync", "col": 2, "type": "messagebus", "label": "mbarrier obj", "sublabel": "shared completion state", "tag": "tracks arrivals / bytes" },
    { "id": "wait", "lane": "sync", "col": 4, "type": "security", "label": "wait_barrier", "sublabel": "wait for phase flip", "tag": "sync scope: CTA or cluster readers" },
    { "id": "consumer_node", "lane": "consumer", "col": 5, "type": "backend", "label": "readers", "sublabel": "local_load / dot operand", "tag": "may read shared tile after wait" }
  ],
  "edges": [
    { "from": "hbm", "to": "tma", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "bottom-channel" },
    { "from": "tmap", "to": "tma", "label": "acquire desc", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "bottom-channel", "labelDy": 18 },
    { "from": "leader", "to": "tma", "label": "launch TMA", "variant": "emphasis", "labelDy": 12 },
    { "from": "tma", "to": "smem", "label": "fill shared", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelDy": 12 },
    { "from": "leader", "to": "mbar", "label": "init + expect", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelDy": 18 },
    { "from": "tma", "to": "mbar", "label": "bytes arrive", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelDy": 12 },
    { "from": "mbar", "to": "wait", "variant": "security" },
    { "from": "wait", "to": "consumer_node", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "What Moves Where",
      "items": [
        "The input tile lives in .global memory",
        "TMA transports it into .shared::cta or .shared::cluster",
        "TensorMap is metadata for the transport engine, not the data tile itself"
      ]
    },
    {
      "dot": "rose",
      "title": "What wait_barrier Means",
      "items": [
        "The thing being waited on is the mbarrier phase, not the engine directly",
        "That phase flips only after all expected arrivals or bytes were recorded",
        "So one wait can join several async TMA tasks at CTA or cluster scope"
      ]
    },
    {
      "dot": "orange",
      "title": "Scope Summary",
      "items": [
        "Launch scope: CTA leader or cluster leader thread",
        "Completion object scope: whichever CTAs share the mbarrier allocation",
        "Consumer scope after wait: CTA readers or cluster readers"
      ]
    }
  ]
}
