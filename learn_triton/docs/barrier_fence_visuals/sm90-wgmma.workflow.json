  "cards": [
    {
      "dot": "emerald",
      "title": "What Moves Where",
      "items": [
        "For this protocol, the input is already a .shared::cta tile",
        "WGMMA consumes shared memory and updates accumulator fragments",
        "The protocol is about async compute completion, not HBM transport"
      ]
    },
    {
      "dot": "rose",
      "title": "Why There Are Two Sync Ideas",
      "items": [
        "fence.proxy.async solves visibility between generic and async proxies",
        "wait_group solves completion of the async MMA set itself",
        "Both matter, but they protect different failure modes"
      ]
    },
    {
      "dot": "orange",
      "title": "Scope Summary",
      "items": [
        "Producer scope before compute: CTA warps publishing shared data",
        "Compute scope: one warp-group executes WGMMA",
        "Wait scope after commit_group: that same warp-group"
      ]
    }
  ]
