  "cards": [
    {
      "dot": "emerald",
      "title": "Main Invariant",
      "items": [
        "A tile becomes reusable only after its target-specific completion point is observed",
        "sm80 publishes per-thread async completion to the CTA with an extra barrier",
        "sm90 splits transport completion and compute completion into different protocols"
      ]
    },
    {
      "dot": "rose",
      "title": "Ordering Boundaries",
      "items": [
        "fence.proxy.async only bridges generic and async visibility domains",
        "mbarrier tracks completion but does not rendezvous the whole CTA",
        "Descriptor and mbarrier objects need their own visibility chains"
      ]
    },
    {
      "dot": "orange",
      "title": "Target Shift",
      "items": [
        "sm80 centers on cp.async commit_group / wait_group",
        "sm90 adds TMA + mbarrier and keeps WGMMA on group wait",
        "sm100 folds tcgen05 completion back into mbarrier and introduces TMEM reuse hazards"
      ]
    }
  ]
}
