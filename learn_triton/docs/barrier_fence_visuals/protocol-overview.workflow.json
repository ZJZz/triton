{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Barrier / Fence Protocols by Target",
    "subtitle": "Each row shows input memory, async module, output memory, and the sync scope that makes the result legal to consume.",
    "output": "learn_triton/docs/barrier_fence_visuals/protocol-overview.html",
    "viewBox": [720, 660]
  },
  "lanes": [
    { "id": "sm80", "label": "sm80 / sm86  |  HBM -> cp.async -> .shared::cta -> wait_group(thread) -> CTA barrier -> CTA consumers" },
    { "id": "sm90tma", "label": "sm90 TMA  |  HBM + TensorMap -> TMA -> .shared::{cta|cluster} -> wait_barrier(CTA/cluster) -> consumers" },
    { "id": "sm90wg", "label": "sm90 WGMMA  |  .shared::cta -> fence.proxy.async -> wgmma -> wait_group(warp-group) -> next stage" },
    { "id": "sm100", "label": "sm100 tcgen05  |  .shared::{cta|cluster} -> tcgen05 -> TMEM -> wait_barrier + hazard barrier -> TMEM consumers" }
  ],
  "phases": [
    { "id": "input", "label": "Input Memory", "fromCol": 0, "toCol": 0 },
    { "id": "issue", "label": "Module + destination", "fromCol": 1, "toCol": 2, "variant": "emphasis" },
    { "id": "sync", "label": "Who Waits / Scope", "fromCol": 4, "toCol": 4, "variant": "security" },
    { "id": "consume", "label": "Legal Consumer", "fromCol": 5, "toCol": 5 }
  ],
  "nodes": [
    { "id": "sm80_in", "lane": "sm80", "col": 0, "type": "external", "label": "HBM tile", "sublabel": ".global memory", "tag": "input memory" },
    { "id": "sm80_mod", "lane": "sm80", "col": 2, "type": "cloud", "label": "cp.async stage", "sublabel": "writes .shared::cta", "tag": "module + output memory" },
    { "id": "sm80_sync", "lane": "sm80", "col": 4, "type": "messagebus", "label": "wait + barrier", "sublabel": "wait_group -> bar.sync", "tag": "thread join, then CTA join" },
    { "id": "sm80_cons", "lane": "sm80", "col": 5, "type": "backend", "label": "CTA consumers", "sublabel": "local_load / mma.sync", "tag": "scope: whole CTA" },

    { "id": "sm90tma_in", "lane": "sm90tma", "col": 0, "type": "external", "label": "HBM tile", "sublabel": ".global memory", "tag": "TensorMap also required" },
    { "id": "sm90tma_mod", "lane": "sm90tma", "col": 2, "type": "cloud", "label": "TMA stage", "sublabel": "fills .shared::cta / ::cluster", "tag": "module + output memory" },
    { "id": "sm90tma_sync", "lane": "sm90tma", "col": 4, "type": "messagebus", "label": "wait_barrier", "sublabel": "mbarrier phase", "tag": "scope: CTA or cluster" },
    { "id": "sm90tma_cons", "lane": "sm90tma", "col": 5, "type": "backend", "label": "readers", "sublabel": "local_load / dot operand", "tag": "may read after wait" },

    { "id": "sm90wg_in", "lane": "sm90wg", "col": 0, "type": "database", "label": "operand tile", "sublabel": ".shared::cta", "tag": "input memory" },
    { "id": "sm90wg_mod", "lane": "sm90wg", "col": 2, "type": "backend", "label": "WGMMA set", "sublabel": "reads shared, writes accum", "tag": "module + output state" },
    { "id": "sm90wg_sync", "lane": "sm90wg", "col": 4, "type": "security", "label": "fence + wait", "sublabel": "proxy fence -> wait_group", "tag": "scope: warp-group" },
    { "id": "sm90wg_cons", "lane": "sm90wg", "col": 5, "type": "backend", "label": "next WG stage", "sublabel": "reuse accumulators", "tag": "same warp-group proceeds" },

    { "id": "sm100_in", "lane": "sm100", "col": 0, "type": "database", "label": "operand tile", "sublabel": ".shared::cta / ::cluster", "tag": "input memory" },
    { "id": "sm100_mod", "lane": "sm100", "col": 2, "type": "backend", "label": "tc05 -> TMEM", "sublabel": "async MMA writes tensor memory", "tag": "module + output memory" },
    { "id": "sm100_sync", "lane": "sm100", "col": 4, "type": "security", "label": "wait + repair", "sublabel": "wait_barrier + TMem barrier", "tag": "completion plus reuse legality" },
    { "id": "sm100_cons", "lane": "sm100", "col": 5, "type": "backend", "label": "TMEM readers", "sublabel": "tcgen05.ld / next stage", "tag": "consumer scope after both checks" }
  ],
  "edges": [
    { "from": "sm80_in", "to": "sm80_mod", "variant": "default" },
    { "from": "sm80_mod", "to": "sm80_sync", "variant": "security" },
    { "from": "sm80_sync", "to": "sm80_cons", "variant": "emphasis" },

    { "from": "sm90tma_in", "to": "sm90tma_mod", "variant": "default" },
    { "from": "sm90tma_mod", "to": "sm90tma_sync", "variant": "security" },
    { "from": "sm90tma_sync", "to": "sm90tma_cons", "variant": "emphasis" },

    { "from": "sm90wg_in", "to": "sm90wg_mod", "variant": "default" },
    { "from": "sm90wg_mod", "to": "sm90wg_sync", "variant": "security" },
    { "from": "sm90wg_sync", "to": "sm90wg_cons", "variant": "emphasis" },

    { "from": "sm100_in", "to": "sm100_mod", "variant": "default" },
    { "from": "sm100_mod", "to": "sm100_sync", "variant": "security" },
    { "from": "sm100_sync", "to": "sm100_cons", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "How To Read Each Row",
      "items": [
        "Column 0 is the input memory type the protocol starts from",
        "Columns 1 to 3 show which hardware module moves or computes the data and where the result lands",
        "Column 4 names the synchronization point and the scope it protects",
        "Column 5 tells you who may legally consume the result after that sync"
      ]
    },
    {
      "dot": "rose",
      "title": "The Key Scope Differences",
      "items": [
        "sm80 starts with per-thread completion, then adds a CTA barrier because the tile is consumed CTA-wide",
        "sm90 TMA waits on mbarrier for CTA or cluster readers, while WGMMA waits only for the warp-group compute set",
        "sm100 also waits on mbarrier, but TMEM reuse hazards may require an extra compiler-inserted barrier"
      ]
    },
    {
      "dot": "orange",
      "title": "What The Diagram Intentionally Separates",
      "items": [
        "Memory type: .global, .shared, and TMEM are different storage classes",
        "Module: cp.async, TMA, WGMMA, and tcgen05 are different hardware engines",
        "Sync scope: thread, warp-group, CTA, and cluster are different sets of participants"
      ]
    }
  ]
}
